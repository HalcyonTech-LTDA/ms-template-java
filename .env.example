# ==============================================================================
# Application & Server Configuration
# ==============================================================================
PORT=8080
TZ=UTC
SPRING_APPLICATION_NAME=ms-example
SPRING_PROFILES_ACTIVE=local
APP_VERSION=1.0.0
ENVIRONMENT=local
JAVA_TOOL_OPTIONS=-Duser.timezone=UTC

# ==============================================================================
# MongoDB Persistence Configuration (Spring Boot 4)
# ==============================================================================
SPRING_MONGODB_URI=mongodb://localhost:27017/example_db
SPRING_MONGODB_DATABASE=example_db
SPRING_MONGODB_AUTO_INDEX_CREATION=true

# ==============================================================================
# OpenFeign HTTP Client Settings (Bureau Integration)
# ==============================================================================
BUREAU_SERVICE_URL=http://localhost:8081
FEIGN_CONNECT_TIMEOUT=5000
FEIGN_READ_TIMEOUT=10000
FEIGN_LOG_LEVEL=BASIC

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_STRUCTURED_FORMAT=ecs

# ==============================================================================
# ShedLock Distributed Locking
# ==============================================================================
SHEDLOCK_LOCK_AT_MOST_FOR=10m


# ==============================================================================
# Scheduled Jobs & Cadences
# ==============================================================================
APP_CUSTOMER_SYNC_JOB_CADENCE=60000
APP_CUSTOMER_SYNC_JOB_LOCK_AT_LEAST_FOR=10s
APP_CUSTOMER_SYNC_JOB_LOCK_AT_MOST_FOR=5m

APP_ORDER_EXPIRATION_JOB_CADENCE=120000
APP_ORDER_EXPIRATION_JOB_LOCK_AT_LEAST_FOR=10s
APP_ORDER_EXPIRATION_JOB_LOCK_AT_MOST_FOR=5m

# ==============================================================================
# OpenTelemetry (OTLP) Traces, Logs & Metrics
# ==============================================================================
MANAGEMENT_OPENTELEMETRY_ENABLED=true
MANAGEMENT_TRACING_ENABLED=true
MANAGEMENT_TRACING_EXPORT_OTLP_ENABLED=true
MANAGEMENT_LOGGING_EXPORT_OTLP_ENABLED=true
MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=true
MANAGEMENT_OTLP_METRICS_EXPORT_STEP=10s
OTEL_SERVICE_NAME=ms-example
OTEL_EXPORTER_OTLP_ENDPOINT_TRACES=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT_LOGS=http://localhost:4318/v1/logs
OTEL_EXPORTER_OTLP_ENDPOINT_METRICS=http://localhost:4318/v1/metrics
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
MANAGEMENT_TRACING_PROPAGATION_TYPE=w3c,b3